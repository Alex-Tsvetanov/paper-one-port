 "command": {
  "script": "<W>\\run_analysis.sh",
  "sha256": "99f9bea5b189dc30a7fb4a0e144a2f617fbb27d6f424cc60921168fb8827c28e",
  "text": "#!/usr/bin/env bash\n# The confirmatory analysis of P3 on W: analysis/analyse.py then analysis/macros.py, into OUT.\n# Usage: run_analysis.sh OUT\nset -euo pipefail\nW=/c/Users/alext/lab/p3/confirm1\nOUT=$1\nU=$W/unpacked\nexport PYTHONUTF8=1 PYTHONNOUSERSITE=1\nPY=$W/venv/Scripts/python.exe\nmkdir -p \"$OUT\"\n\"$PY\" -s \"$W/src/analysis/analyse.py\" \\\n  --seeds \"$W/src/design/seeds.json\" \\\n  --pilot \"$W/files-L/pilot.json\" \\\n  --rule-e \"$W/files-L/rule_e.json\" \\\n  --gate \"$W/files-L/gate-L.json\" --gate \"$W/files-W/gate-W.json\" \\\n  --rows \"$U/pc1/cost-L/windows.jsonl\" \\\n  --rows \"$U/wc1-wc2/cost-W/windows.jsonl\" \\\n  --rows \"$U/ml1/m-L/windows.jsonl\" \\\n  --rows \"$U/wm1/m-W/windows.jsonl\" \\\n  --rows \"$U/bk1-bs1/b3-L/windows.jsonl\" \\\n  --rows \"$U/sl3/s-L/windows.jsonl\" \\\n  --rows \"$U/ws1/s-W/windows.jsonl\" \\\n  --out \"$OUT\"\n\"$PY\" -s \"$W/src/analysis/macros.py\" \"$OUT/summary.json\" --out \"$OUT/macros.tex\"\n"
 },
